# ============================================================================
# Drivo Backend Environment Configuration
# Copy this file to `server/.env` and set your credentials.
# Never commit real passwords to version control.
# ============================================================================

# --- Option 1: Configure MySQL via individual variables ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=drivo_db

# --- Option 2: Or provide a full SQLAlchemy DATABASE_URL ---
# Example MySQL:  DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/drivo_db
# Example SQLite: DATABASE_URL=sqlite:///./drivo_fallback.db
DATABASE_URL=

# Keep SQLite fallback enabled when local MySQL is not running or password is not set yet.
# Set to `false` in production to enforce strict MySQL connection on startup.
USE_SQLITE_FALLBACK=true

# --- Server Host & Port ---
HOST=127.0.0.1
PORT=8000

# --- JWT Authentication ---
JWT_SECRET=drivo-super-secret-jwt-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
