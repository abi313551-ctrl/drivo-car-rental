# ============================================================================
# Drivo Backend Environment Configuration
# Copy this file to `server/.env` and set your credentials.
# Never commit real passwords to version control.
# ============================================================================

# --- Option 1: Configure MySQL via individual variables ---
# (Supports standard names or Railway aliases: MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=drivo_db

# --- Option 2: Or provide a full connection URL (Render / Railway) ---
# Automatically accepts:
# - Railway `MYSQL_URL` (e.g. mysql://root:password@host:port/railway)
# - SQLAlchemy `DATABASE_URL` (e.g. mysql+pymysql://root:password@host:port/railway)
DATABASE_URL=

# Keep SQLite fallback enabled for local dev when MySQL is not running.
# In Render (when RENDER=true or ENVIRONMENT=production), this automatically defaults to false
# to strictly enforce Railway MySQL connection and prevent data loss.
USE_SQLITE_FALLBACK=true

# --- Server Host & Port ---
HOST=127.0.0.1
PORT=8000

# --- JWT Authentication ---
JWT_SECRET=replace_with_a_secure_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Razorpay Payment Gateway (Test Mode) ---
# Generate free test mode API keys at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Google OAuth / Identity Services ---
# Get your Web Client ID from Google Cloud Console > APIs & Services > Credentials
# Example: 1234567890-abcdefg.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# --- SMTP Real Email Delivery Configuration ---
# Configure your SMTP credentials to send real registration/password OTPs and booking confirmations
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@drivo.com
SMTP_FROM_NAME=Drivo Car Rentals
SMTP_TLS=true

# For automated development/staging testing without real SMTP, set DRIVO_EMAIL_MOCK=true
DRIVO_EMAIL_MOCK=false

